{
  "name": "quiet-evening",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:add-task": "npm run build && node tests/add-task.mjs",
    "test:preview": "npm run build && node tests/preview-sandbox.mjs",
    "test:combos": "npm run build && node tests/combo-summary-ui.mjs",
    "test:notes": "npm run build && node tests/notes-ui.mjs",
    "test:arrival": "npm run build && node tests/arrival-ui.mjs",
    "test:navigation": "npm run build && node tests/navigation-overlay.mjs",
    "test:clothes": "npm run build && node tests/clothes-ui.mjs",
    "test:arrival-link": "npm run build && node tests/arrival-link.mjs",
    "test:updates": "npm run build && node tests/pwa-update.mjs",
    "test:finish-chart": "npm run build && node tests/finish-chart-ui.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
